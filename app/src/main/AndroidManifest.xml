<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" />
    <!-- Only apps signed with the same key (Reader's Launcher) may read today's counts. -->
    <permission
        android:name="com.freedomfighter.readersfoodlog.permission.ACCESS"
        android:protectionLevel="signature" />

    <!-- allowBackup off: the journal stays on the phone; export/import is the user's own move. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReadersFoodLog">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- Its own task, so a shot from the widget or the tile ends where it started. -->
        <activity
            android:name=".CaptureActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:screenOrientation="portrait"
            android:taskAffinity="com.freedomfighter.readersfoodlog.capture" />
        <receiver android:name=".widget.ShotWidget" android:exported="true" android:label="@string/widget_shot_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_shot_info" />
        </receiver>
        <receiver android:name=".widget.LineWidget" android:exported="true" android:label="@string/widget_line_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_line_info" />
        </receiver>
        <service
            android:name=".ShotTile"
            android:exported="true"
            android:icon="@drawable/ic_plate"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <provider
            android:name=".provider.TodayProvider"
            android:authorities="com.freedomfighter.readersfoodlog"
            android:exported="true"
            android:permission="com.freedomfighter.readersfoodlog.permission.ACCESS" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.freedomfighter.readersfoodlog.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
